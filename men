#include <stdio.h>

int main() {
    int a[100], n, i, ch, pos, item, found = 0;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements: ");
    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    do {
        printf("\n1.Insert\n2.Delete\n3.Search\n4.Display\n5.Exit\n");
        printf("Enter choice: ");
        scanf("%d", &ch);

        switch(ch) {
            case 1:
                printf("Enter position and element: ");
                scanf("%d%d", &pos, &item);
                for(i = n; i >= pos; i--)
                    a[i] = a[i - 1];
                a[pos - 1] = item;
                n++;
                break;

            case 2:
                printf("Enter position: ");
                scanf("%d", &pos);
                for(i = pos - 1; i < n - 1; i++)
                    a[i] = a[i + 1];
                n--;
                break;

            case 3:
                printf("Enter element to search: ");
                scanf("%d", &item);
                found = 0;
                for(i = 0; i < n; i++) {
                    if(a[i] == item) {
                        printf("Found at position %d\n", i + 1);
                        found = 1;
                        break;
                    }
                }
                if(!found)
                    printf("Element not found\n");
                break;

            case 4:
                printf("Array: ");
                for(i = 0; i < n; i++)
                    printf("%d ", a[i]);
                printf("\n");
                break;

            case 5:
                printf("Exit");
                break;

            default:
                printf("Invalid choice");
        }

    } while(ch != 5);

    return 0;
}
